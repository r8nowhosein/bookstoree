{
  "name": "bookstore",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "sass": "sass src/styles.scss src/styles.css --watch",
    "tw": "npx @tailwindcss/cli -i ./src/input.css -o ./src/output.css --watch --content \"./src/**/*.{html,js,ts,jsx,tsx}\"",
    "dev": "npm-run-all --parallel sass tw",
    "build": "sass src/styles.scss src/styles.css && npx @tailwindcss/cli -i ./src/input.css -o ./src/output.css --minify --content \"./src/**/*.{html,js,ts,jsx,tsx}\""
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.14",
    "tailwindcss": "^4.1.14"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "sass": "^1.93.2"
  }
}
